<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/tikkie_dark_purple</item>
        <item name="colorPrimaryDark">@color/tikkie_dark_purple</item>
        <item name="colorAccent">@color/tikkie_teal</item>
        <item name="android:windowBackground">@color/tikkie_dark_purple</item>
        <item name="android:textColorPrimary">@color/tikkie_text_white</item>
        <item name="android:textColorSecondary">@color/tikkie_text_gray</item>
    </style>
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/tikkie_dark_purple</item>
        <item name="android:textColorPrimary">@color/tikkie_text_white</item>
        <item name="android:textColorSecondary">@color/tikkie_text_gray</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

</resources>

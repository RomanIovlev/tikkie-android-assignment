<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tikkie_keyboard_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Row 1: 1, 2, 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/button1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="1"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="2"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="3"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />
    </LinearLayout>

    <!-- Row 2: 4, 5, 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="4"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button5"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="5"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button6"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="6"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />
    </LinearLayout>

    <!-- Row 3: 7, 8, 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/button7"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="7"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button8"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="8"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button9"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="9"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />
    </LinearLayout>

    <!-- Row 4: , 0, . -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/buttonComma"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text=","
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/button0"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />

        <Button
            android:id="@+id/buttonDot"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="."
            android:textColor="@color/tikkie_text_white"
            android:textSize="24sp"
            android:background="@color/tikkie_purple_card" />
    </LinearLayout>

</LinearLayout>

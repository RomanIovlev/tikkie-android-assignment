<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tikkie_dark_purple"
    tools:context=".RequestPaymentStep2Activity">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/tikkie_text_white" />

    <!-- Info Button -->
    <ImageButton
        android:id="@+id/infoButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_info"
        android:contentDescription="Info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/tikkie_text_white" />

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/what_is_it_for"
        android:textColor="@color/tikkie_text_white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backButton" />

    <!-- Description Input -->
    <EditText
        android:id="@+id/descriptionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:background="@android:color/transparent"
        android:hint="Dinner"
        android:inputType="text"
        android:padding="0dp"
        android:textColor="@color/tikkie_teal"
        android:textColorHint="@color/tikkie_teal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:minHeight="48dp"
        android:gravity="start|center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/title" />

    <!-- Character Count -->
    <TextView
        android:id="@+id/characterCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="0"
        android:textColor="@color/tikkie_text_white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/descriptionInput" />

    <!-- Share Buttons -->
    <LinearLayout
        android:id="@+id/shareButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- WhatsApp Button (rounded rectangle) -->
        <Button
            android:id="@+id/whatsappButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/rounded_button_background"
            android:paddingHorizontal="28dp"
            android:paddingVertical="14dp"
            android:text="WhatsApp"
            android:textColor="@color/tikkie_text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_whatsapp"
            android:drawablePadding="8dp"
            android:gravity="center" />

        <!-- QR Code Button (round, green) -->
        <ImageButton
            android:id="@+id/qrCodeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_button_background"
            app:srcCompat="@drawable/ic_qr_code"
            android:contentDescription="QR Code"
            app:tint="@color/tikkie_text_white" />

        <!-- Share Button (round, green) -->
        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background"
            app:srcCompat="@drawable/ic_share"
            android:contentDescription="Share"
            app:tint="@color/tikkie_text_white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
